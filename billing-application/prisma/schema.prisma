generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique @db.VarChar(50)
  password String  @db.VarChar(255)
  role     String? @default("waiter") @db.VarChar(20)

  @@map("users")
}

model Stocks {
  unique_id       Int     @id @default(autoincrement())
  product_name String  @db.VarChar(50)
  quantity String  @db.VarChar(15)

  @@map("stocks")
}

model Bills {
  id       Int     @id @default(autoincrement())
  table_id Int
  bill_data Json

  @@map("bills")
}
